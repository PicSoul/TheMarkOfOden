<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <AssemblyName>MarkOfOden</AssemblyName>
    <RootNamespace>MarkOfOden</RootNamespace>
    <Product>The Mark of Oden</Product>
    <Version>0.1.22</Version>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <EnableDefaultCompileItems>true</EnableDefaultCompileItems>
  </PropertyGroup>

  <ItemGroup>
    <!-- Publicizes the referenced game assembly at build time so we can touch
         MonsterAI.m_targetCreature, BaseAI.Flee, Character.m_lastHit, etc.
         Nothing publicized is ever written back to the game folder. -->
    <PackageReference Include="BepInEx.AssemblyPublicizer.MSBuild" Version="0.4.2" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="assembly_valheim">
      <HintPath>$(ValheimManaged)\assembly_valheim.dll</HintPath>
      <Publicize>true</Publicize>
      <Private>false</Private>
    </Reference>
    <Reference Include="assembly_utils">
      <HintPath>$(ValheimManaged)\assembly_utils.dll</HintPath>
      <Publicize>true</Publicize>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <Reference Include="UnityEngine">
      <HintPath>$(ValheimManaged)\UnityEngine.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(ValheimManaged)\UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.PhysicsModule">
      <HintPath>$(ValheimManaged)\UnityEngine.PhysicsModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.AnimationModule">
      <HintPath>$(ValheimManaged)\UnityEngine.AnimationModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.AIModule">
      <HintPath>$(ValheimManaged)\UnityEngine.AIModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <Reference Include="BepInEx">
      <HintPath>$(BepInExCore)\BepInEx.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>$(BepInExCore)\0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <!-- Needed by the vendored ServerSync/ConfigSync.cs. -->
    <Reference Include="Unity.TextMeshPro">
      <HintPath>$(ValheimManaged)\Unity.TextMeshPro.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.UI">
      <HintPath>$(ValheimManaged)\UnityEngine.UI.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.UIModule">
      <HintPath>$(ValheimManaged)\UnityEngine.UIModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.TextRenderingModule">
      <HintPath>$(ValheimManaged)\UnityEngine.TextRenderingModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.IMGUIModule">
      <HintPath>$(ValheimManaged)\UnityEngine.IMGUIModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="System.IO.Compression">
      <HintPath>$(ValheimManaged)\System.IO.Compression.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="System.Runtime.Serialization">
      <HintPath>$(ValheimManaged)\System.Runtime.Serialization.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <!-- Optional: drop the build straight into a local profile. Off unless DeployProfile is set. -->
  <Target Name="DeployToProfile" AfterTargets="Build" Condition="'$(DeployPluginsDir)' != ''">
    <Error Condition="!Exists('$(DeployPluginsDir)')"
           Text="DeployProfile '$(DeployProfile)' has no plugins folder at '$(DeployPluginsDir)'." />
    <MakeDir Directories="$(DeployPluginsDir)\TheMarkOfOden" />
    <!-- No ContinueOnError: a deploy that silently fails, because the game has the file open,
         leaves an older build in the profile while the build still reports success. -->
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(DeployPluginsDir)\TheMarkOfOden" Retries="3" RetryDelayMilliseconds="500" />
    <Message Importance="high" Text="Deployed $(TargetFileName) v$(Version) -> $(DeployPluginsDir)\TheMarkOfOden" />
  </Target>

</Project>
