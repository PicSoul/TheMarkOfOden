<!--
  Copy this file to Local.props and edit the paths for your machine.
  Local.props is gitignored, so your paths stay out of the repository.

  Both properties are optional. If you omit them the build falls back to the
  VALHEIM_INSTALL / BEPINEX_CORE environment variables, then to the default
  Steam install location.
-->
<Project>
  <PropertyGroup>

    <!-- Your Valheim folder: the one containing valheim.exe -->
    <ValheimInstall>C:\Program Files (x86)\Steam\steamapps\common\Valheim</ValheimInstall>

    <!--
      The BepInEx\core folder holding BepInEx.dll and 0Harmony.dll.

      Manual BepInEx install: leave this commented out, it is found automatically
      inside the Valheim folder.

      r2modman / Thunderstore Mod Manager: BepInEx lives in the profile instead,
      so point at it explicitly, for example:
    -->
    <!-- <BepInExCore>$(AppData)\r2modmanPlus-local\Valheim\profiles\Default\BepInEx\core</BepInExCore> -->

    <!-- Optional: build deploys the DLL straight into this profile's plugins folder -->
    <!-- <DeployProfile>Default</DeployProfile> -->

    <!--
      If you also installed the mod through r2modman, point this at the folder it created,
      usually Team-ModName. Otherwise you end up with two copies in one profile and BepInEx
      loads whichever it likes, which makes a rebuilt DLL look like it changed nothing.
    -->
    <!-- <DeployFolder>PICS0UL-TheMarkOfOden</DeployFolder> -->

  </PropertyGroup>
</Project>
